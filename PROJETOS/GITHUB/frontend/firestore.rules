rules_version = '2';

// Banco do DP (projeto macro-ambiental) — fechado em 04/11/2026.
// Antes: allow read, write: if true (aberto para a internet).
//
// Só entra quem fez login pelo Suporte ou pelo Oficial: a function entrarDP
// confere usuário/senha e abre uma sessão do Firebase Auth com uid = id do
// systemUsers e a marca dp = true. Usuário desativado (active == false) perde
// o acesso na hora, mesmo com a sessão aberta.
//
// NÃO afeta quem usa conta de serviço (Admin SDK ignora as regras): functions
// do DP (Secullum, rotinas, pontoPerformance), Almoxarifado, RH, Contratos,
// Qualidade, Equipamentos.
//
// Permissão por tela continua sendo conferida na tela (próximo passo).
//
// 05/11/2026 (F2c): usuários, permissões e chaves de acesso só são gravados
// pela function gravarAcessosDP (que confere quem pode mudar o quê); o
// navegador só lê. loginAttempts (contador do limite de login) nem lê.
// F3: senhas em systemUserSecrets e registro de "Ver senha" em senhaConsultas
// também fechados por completo.
//
// Voltar atrás em emergência: trocar as condições por `true` e publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function usuarioDP() {
      return request.auth != null
        && request.auth.token.dp == true
        && get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.get("active", true) != false;
    }

    function colecaoSoServidor(colecao) {
      return colecao in ["systemUsers", "systemPermissions", "accessKeys"];
    }

    // Nem leitura: só as functions (Admin SDK) usam.
    function colecaoFechada(colecao) {
      return colecao in ["loginAttempts", "systemUserSecrets", "senhaConsultas", "pontoPerformanceCache"];
    }

    match /{colecao}/{document=**} {
      allow read: if !colecaoFechada(colecao) && usuarioDP();
      allow write: if !colecaoFechada(colecao) && !colecaoSoServidor(colecao) && usuarioDP();
    }

    // Leitura do ponto por período (collectionGroup "employeePoints": Apuração
    // de Benefícios, Controle RH, histórico por funcionário). A regra de cima
    // não vale para collectionGroup porque usa o nome da coleção raiz.
    match /{caminho=**}/employeePoints/{registro} {
      allow read: if usuarioDP();
    }
  }
}
